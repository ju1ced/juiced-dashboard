# Local, environment-specific entity mapping — never commit real entity IDs.
*.local.yaml
*.local.yml

# Home Assistant internal state
.storage/

# Rendered output (contains real entity IDs)
build/

# Node / tooling
node_modules/

# Reproducible HACS release artifacts — the bundle itself (dist/juiced-dashboard.js)
# stays tracked, only the generated manifest/checksum are regenerated per build.
dist/*.sha256
dist/release-manifest.json

# Python
__pycache__/
*.pyc

# Local HA credentials for the perf harness — never commit
perf/ha.env
*.token
